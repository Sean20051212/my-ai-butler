# ── LLM provider ─────────────────────────────────────────────────────────────
# Which LLM backend to use. Options:
#   ollama  — local inference via Ollama (default)
#   cloud   — hosted API (NOT YET IMPLEMENTED; raises NotImplementedError)
LLM_PROVIDER=ollama

# ── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:7b
VISION_MODEL=llava

# ── TTS ──────────────────────────────────────────────────────────────────────
# Which TTS backend to use. Options:
#   cosyvoice — local CosyVoice2 fukalos voice, served from the WSL cosyvoice
#               conda env (see tts_service/butler_tts_server.py). Requires that
#               server to be running (start.bat launches it).
#   cloud     — hosted vendor skeleton, NOT implemented (returns None / silent).
TTS_PROVIDER=cosyvoice
# URL of the WSL CosyVoice inference server's /tts endpoint.
COSYVOICE_TTS_URL=http://localhost:9880/tts

# ── STT (voice input) ────────────────────────────────────────────────────────
# Speech-to-text backend. Options:
#   whisper — local faster-whisper (default). Requires: pip install faster-whisper
STT_PROVIDER=whisper
# faster-whisper settings. Defaults keep it on the CPU (off the tight GPU).
#   model size:   tiny | base | small | medium | large-v3  (bigger = accurate/slower)
#   device:       cpu | cuda
#   compute type: int8 (CPU) | float16 (GPU) | …
#   language:     zh (Chinese-primary) | "" for auto-detect
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=zh

# ── Audio cache ──────────────────────────────────────────────────────────────
# Generated audio is cached here; same text always hits cache on second request.
AUDIO_CACHE_DIR=./cache/audio

# ── Obsidian memory (optional) ───────────────────────────────────────────────
# Leave blank to disable long-term memory entirely.
# When set, the vault is indexed into ChromaDB and relevant notes are injected
# into every system prompt.  Replies are also written back to the vault under
# AI-Butler-Memory/YYYY-MM-DD.md.
# Requires: pip install chromadb  AND  ollama pull nomic-embed-text
OBSIDIAN_VAULT_PATH=
EMBED_MODEL=nomic-embed-text
CHROMA_DB_PATH=./data/chroma
